<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_slate"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header / Judul -->
    <TextView
        android:id="@+id/tvWelcomeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:text="LENTERA KEHIDUPAN"
        android:textColor="@color/primary_gray"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif"
        android:text="Pilih kanon Alkitab yang ingin Anda baca"
        android:textColor="@color/text_muted"
        android:textSize="14sp" />

    <!-- Input Nama Pembaca -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilNamaPengguna"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="Nama Anda (contoh: Josua)"
        app:boxBackgroundColor="@color/surface_white"
        app:boxCornerRadiusBottomEnd="0dp"
        app:boxCornerRadiusBottomStart="0dp"
        app:boxCornerRadiusTopEnd="0dp"
        app:boxCornerRadiusTopStart="0dp"
        app:boxStrokeColor="@color/primary_gray"
        app:hintTextColor="@color/primary_gray">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNamaPengguna"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:textColor="@color/text_dark"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Container Pilihan Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical">

        <!-- Card Pilihan Katolik -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardKatolik"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/surface_white"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/primary_gray"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:text="ALKITAB KATOLIK"
                    android:textColor="@color/primary_gray"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:text="73 Kitab • 1.334 Pasal"
                    android:textColor="@color/primary_red"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:text="Termasuk kitab Deuterokanonika (Tobit, Yudit, Kebijaksanaan Salomo, Sirakh, Barukh, 1-2 Makabe, dan tambahan Ester &amp; Daniel)."
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card Pilihan Protestan -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProtestan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/surface_white"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_light"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:text="ALKITAB PROTESTAN"
                    android:textColor="@color/primary_gray"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:text="66 Kitab • 1.189 Pasal"
                    android:textColor="@color/primary_red"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:text="39 Kitab Perjanjian Lama &amp; 27 Kitab Perjanjian Baru (standar kanon protestan)."
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Tombol Mulai Membaca -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMulaiMembaca"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="@color/primary_gray"
        android:fontFamily="sans-serif-condensed"
        android:text="MULAI MEMBACA"
        android:textColor="@color/surface_white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="0dp"
        app:elevation="0dp" />

</LinearLayout>
