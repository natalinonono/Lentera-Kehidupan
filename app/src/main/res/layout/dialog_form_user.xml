<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header Dialog -->
    <TextView
        android:id="@+id/tvFormTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:text="Profil Pengguna Baru"
        android:textColor="@color/primary_gray"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="sans-serif"
        android:text="Lengkapi kriteria data pengguna dan target harian"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="420dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Username -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Username / ID Panggilan:"
                android:textColor="@color/primary_gray"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etFormUsername"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="sans-serif"
                android:hint="Contoh: Josua"
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_subtle"
                android:textSize="14sp" />

            <!-- Nama Lengkap -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Lengkap:"
                android:textColor="@color/primary_gray"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etFormNamaLengkap"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="sans-serif"
                android:hint="Contoh: Josua Pratama"
                android:inputType="textPersonName"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_subtle"
                android:textSize="14sp" />

            <!-- Tempat, Tanggal Lahir (TTL) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tempat, Tanggal Lahir (TTL):"
                android:textColor="@color/primary_gray"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etFormTTL"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="sans-serif"
                android:hint="Contoh: Semarang, 15 Mei 2007"
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_subtle"
                android:textSize="14sp" />

            <!-- Jenis Kelamin -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jenis Kelamin:"
                android:textColor="@color/primary_gray"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgJenisKelamin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbLaki"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Laki-laki"
                    android:textColor="@color/text_dark" />

                <RadioButton
                    android:id="@+id/rbPerempuan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:text="Perempuan"
                    android:textColor="@color/text_dark" />
            </RadioGroup>

            <!-- Pilihan Target Bab per Hari -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Target Bacaan (Berapa Bab / Hari):"
                android:textColor="@color/primary_gray"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etFormTargetBab"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="sans-serif"
                android:hint="Contoh: 1, 2, atau 3"
                android:inputType="number"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:text="1"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_subtle"
                android:textSize="14sp" />

            <!-- Komitmen / Catatan Pribadi Rohani -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Komitmen / Doa Rohani Pribadi:"
                android:textColor="@color/primary_gray"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etFormKomitmen"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="sans-serif"
                android:gravity="top|start"
                android:hint="Misal: Tekun membaca setiap pagi sebelum sekolah"
                android:inputType="textMultiLine"
                android:maxLines="3"
                android:padding="10dp"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_subtle"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>

    <!-- Tombol Simpan & Batal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBatalForm"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Batal"
            android:textColor="@color/text_muted"
            app:cornerRadius="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSimpanForm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/primary_gray"
            android:text="Simpan Pengguna"
            android:textColor="@color/surface_white"
            app:cornerRadius="0dp" />
    </LinearLayout>

</LinearLayout>
