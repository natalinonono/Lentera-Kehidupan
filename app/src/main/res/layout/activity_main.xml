<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_slate"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Judul Aplikasi -->
    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:text="SELESAIKAN ALKITABMU"
        android:textColor="@color/primary_gray"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Card / Kotak Konten Utama (Flat Tanpa Lengkungan) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="@color/surface_white"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="BACAAN HARI INI"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Nama Kitab & Pasalnya (Contoh: Kejadian 1) -->
        <TextView
            android:id="@+id/tvNamaKitab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-condensed"
            android:text="Kejadian 1"
            android:textColor="@color/text_dark"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Keterangan Urutan Pasal Global -->
        <TextView
            android:id="@+id/tvPasal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:text="(Pasal ke-1 dari 1334)"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <!-- Streak Bacaan (Tanpa Ikon Api) -->
        <TextView
            android:id="@+id/tvStreak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-condensed"
            android:text="Streak: 0 Hari"
            android:textColor="@color/primary_red"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="@color/border_light" />

        <!-- Progress Bar & Jumlah Pasal -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="PROGRESS MEMBACA"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="10dp"
            android:progress="1"
            android:progressTint="@color/primary_red" />

        <TextView
            android:id="@+id/tvProgressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"
            android:text="1 / 1334 pasal"
            android:textColor="@color/text_dark"
            android:textSize="14sp" />

        <!-- Pilihan Versi Alkitab (Kristen Protestan / Katolik) Flat -->
        <RadioGroup
            android:id="@+id/rgCanon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbKatolik"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:fontFamily="sans-serif-condensed"
                android:text="Katolik (73 Kitab)"
                android:textColor="@color/text_dark"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbProtestan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="sans-serif-condensed"
                android:text="Protestan (66 Kitab)"
                android:textColor="@color/text_dark"
                android:textSize="13sp" />
        </RadioGroup>

        <!-- Tombol Aksi (Flat Kaku Tanpa Rounded) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTandaiSelesai"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/primary_gray"
            android:fontFamily="sans-serif-condensed"
            android:text="TANDAI SELESAI HARI INI"
            android:textColor="@color/surface_white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="0dp"
            app:elevation="0dp" />

        <!-- Tombol Reset Project Flat -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReset"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-condensed"
            android:text="RESET PROGRES"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="0dp" />

    </LinearLayout>

</LinearLayout>
